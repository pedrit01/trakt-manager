# Copia este fichero a .env y rellena los valores. .env no se sube al repositorio.

# Credenciales de tu aplicación de Trakt: https://trakt.tv/oauth/applications
# (Redirect URI de la aplicación: urn:ietf:wg:oauth:2.0:oob)
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# Clave que deben enviar los clientes de la API en la cabecera X-API-Key.
# Genera una con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Dónde se publica la API en el anfitrión.
# 127.0.0.1 = solo este equipo; 0.0.0.0 = toda la red (usa una API_KEY robusta).
API_BIND=127.0.0.1
API_PORT=8000

# Pausa mínima entre peticiones a Trakt, en segundos.
REQUEST_DELAY=0.2
